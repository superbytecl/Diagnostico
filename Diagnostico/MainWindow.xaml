<Window x:Class="Diagnostico.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Diagnostics Dashboard"
        Height="194" Width="894"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="IconCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Aqua" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" 
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="Red"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="MinimizeButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CloseButtonStyle}">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>
    <Border Background="#1E1E1E" CornerRadius="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
        Background="#2D2D30" 
        CornerRadius="12,12,0,0" Margin="0,0,0,10"
        MouseDown="TitleBar_MouseDown"
       >
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Image Source="/Iconos/icon.ico" 
                   Height="16" 
                   Width="16" 
                   Margin="0,0,5,0"
                   />

                        <TextBlock Text="Diagnostico " 
                       FontSize="11" 
                       FontWeight="SemiBold" 
                       Foreground="#CCCCCC" 
                       VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="—" 
                    VerticalAlignment="Center" 
                    Width="30" Height="30" 
                    Style="{StaticResource MinimizeButtonStyle}"
                    Click="MinimizeButton_Click"
                    Margin="0,0,0,0"
                  />

                        <Button Content="✕" 
                    VerticalAlignment="Center" 
                    Width="30" Height="30" 
                    Style="{StaticResource CloseButtonStyle}"
                    Click="CloseButton_Click"
                    Margin="0,0,0,0"
                  />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Top" Margin="0,24,0,0" Grid.RowSpan="2">

                <Border x:Name="CpuZCard" Style="{StaticResource IconCardStyle}" MouseLeftButtonUp="IconCard_MouseLeftButtonUp">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Height="64" Width="64" Source="/Iconos/Cpu-Z.png" Margin="0,0,0,5"/>
                        <TextBlock Text="CPU-Z" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Información de CPU y placa base." HorizontalAlignment="Center" TextAlignment="Center" FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" MaxWidth="100"/>
                    </StackPanel>
                </Border>

                <Border x:Name="MemoryCleanerCard" Style="{StaticResource IconCardStyle}" MouseLeftButtonUp="IconCard_MouseLeftButtonUp">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Height="64" Width="64" Source="/Iconos/WinMemoryCleaner.png" Margin="0,0,0,5"/>
                        <TextBlock Text="MemoryCleaner" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Optimiza y libera memoria RAM." 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="11"
                               Foreground="#AAAAAA"
                               TextWrapping="Wrap"
                               MaxWidth="100"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CrystalDiskCard" Style="{StaticResource IconCardStyle}" MouseLeftButtonUp="IconCard_MouseLeftButtonUp">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Height="64" Width="64" Source="/Iconos/Crystal Disk.png" Margin="0,0,0,5"/>
                        <TextBlock Text="CrystalDisk" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Diagnóstico del estado del disco." HorizontalAlignment="Center" TextAlignment="Center" FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" MaxWidth="100"/>
                    </StackPanel>
                </Border>

                <Border x:Name="WinDirStatCard" Style="{StaticResource IconCardStyle}" MouseLeftButtonUp="IconCard_MouseLeftButtonUp">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Height="64" Width="64" Source="/Iconos/WinSatDir.png" Margin="0,0,0,5"/>
                        <TextBlock Text="WinDirStat" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Analiza qué archivos ocupan más espacio." 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="11"
                               Foreground="#AAAAAA"
                               TextWrapping="Wrap"
                               MaxWidth="100"/>
                    </StackPanel>
                </Border>

                <Border x:Name="GeekUninstallCard" Style="{StaticResource IconCardStyle}" MouseLeftButtonUp="IconCard_MouseLeftButtonUp">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Height="64" Width="64" Source="/Iconos/Geek Unistaller.png" Margin="0,0,0,5"/>
                        <TextBlock Text="Geek Uninstall" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Desinstala programas por completo." HorizontalAlignment="Center" TextAlignment="Center" FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" MaxWidth="100"/>
                    </StackPanel>
                </Border>

                <Border x:Name="HwinfoCard" Style="{StaticResource IconCardStyle}" MouseLeftButtonUp="IconCard_MouseLeftButtonUp">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Height="64" Width="64" Source="/Iconos/HWiNFO.png" Margin="0,0,0,5"/>
                        <TextBlock Text="HWiNFO" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Monitorea hardware en tiempo real." HorizontalAlignment="Center" TextAlignment="Center" FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" MaxWidth="100"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Border>
</Window>